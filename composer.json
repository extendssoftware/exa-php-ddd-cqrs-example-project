{
  "name": "extendssoftware/exa-php-ddd-cqrs-example-project",
  "type": "project",
  "license": "MIT",
  "description": "ExaPHP sample project with DDD and CQRS.",
  "homepage": "https://github.com/extendssoftware/exa-php-ddd-cqrs-example-project",
  "authors": [
    {
      "name": "Vincent van Dijk",
      "email": "vincent@extends.nl",
      "homepage": "https://www.extends.nl/"
    }
  ],
  "require": {
    "php": "^8.5",
    "extendssoftware/exa-php": "^0.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "guzzle/guzzle": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "ExtendsSoftware\\ExaPHPExample\\Application\\": "module/Application/src/"
