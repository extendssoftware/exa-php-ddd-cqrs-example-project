{
  "name": "extendssoftware/exa-php-ddd-cqrs-example-project",
  "type": "project",
  "license": "MIT",
  "description": "ExaPHP sample project with DDD and CQRS.",
  "homepage": "https://github.com/extendssoftware/exa-php-ddd-cqrs-example-project",
  "authors": [
    {
      "name": "Vincent van Dijk",
      "email": "vincent@extends.nl",
      "homepage": "https://www.extends.nl/"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "ramsey/uuid": "^4.9",
    "extendssoftware/exa-php": "^0.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "guzzlehttp/guzzle": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "ExtendsSoftware\\ExaPHPExample\\Application\\": "module/Application/src/",
      "ExtendsSoftware\\ExaPHPExample\\Shared\\": "module/Shared/src/",
      "ExtendsSoftware\\ExaPHPExample\\Task\\": "module/Task/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ExtendsSoftware\\ExaPHPExample\\Application\\Tests\\": "module/Application/tests/",
      "ExtendsSoftware\\ExaPHPExample\\Shared\\Tests\\": "module/Shared/tests/",
      "ExtendsSoftware\\ExaPHPExample\\Task\\Tests\\": "module/Task/tests/"
    }
  }
}
